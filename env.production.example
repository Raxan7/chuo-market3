# ChuoSmart production environment template.
# Copy values into your hosting environment or a protected .env file.
# NEVER commit real secrets.

DJANGO_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
TIME_ZONE=Africa/Dar_es_Salaam

DB_NAME=chuosmart_db
DB_USER=chuosmart_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=3306

# Email / SMTP
EMAIL_HOST=server311.web-hosting.com
EMAIL_PORT=465
EMAIL_HOST_USER=support@chuosmart.com
SUPPORT_EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=ChuoSmart <support@chuosmart.com>
NEWSLETTER_DEBUG=false
NEWSLETTER_TEST_EMAIL=
NEWSLETTER_LOG_EMAIL=support@chuosmart.com
# Marketing sender identity. Keep this on a domain with working SPF/DKIM/DMARC.
MARKETING_FROM_EMAIL=ChuoSmart Updates <support@chuosmart.com>
MARKETING_REPLY_TO=support@chuosmart.com
MARKETING_LIST_ID=updates.chuosmart.com
MARKETING_BUSINESS_ADDRESS=ChuoSmart, Tanzania

# Dedicated marketing SMTP. Strongly recommended for bulk/promotional mail so
# transactional password resets/job notifications remain isolated.
# If omitted, marketing falls back to the normal EMAIL_* connection.
MARKETING_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MARKETING_EMAIL_HOST=
MARKETING_EMAIL_PORT=587
MARKETING_EMAIL_HOST_USER=
MARKETING_EMAIL_HOST_PASSWORD=
MARKETING_EMAIL_USE_SSL=false
MARKETING_EMAIL_USE_TLS=true
MARKETING_EMAIL_TIMEOUT=30

# Conservative warm-up / deliverability controls. Increase only after checking
# your SMTP provider quota and Gmail/Yahoo reputation metrics.
MARKETING_EMAIL_MAX_PER_RUN=10
MARKETING_EMAIL_BURST_CAP=3
MARKETING_EMAIL_TEN_MINUTE_CAP=15
MARKETING_EMAIL_HOURLY_CAP=100
MARKETING_EMAIL_DAILY_CAP=1500
MARKETING_EMAIL_SECONDS_BETWEEN_SENDS=1
MARKETING_EMAIL_RETRY_BASE_MINUTES=10
MARKETING_EMAIL_STALE_MINUTES=30
MARKETING_EMAIL_MAX_ATTEMPTS=5
MARKETING_SERIALIZE_CAMPAIGNS=true

# Automatic database-content marketing queue. Existing eligible content is
# backfilled newest-first with sync_marketing_content_queue.
CONTENT_MARKETING_CAMPAIGN_GAP_HOURS=24
CONTENT_MARKETING_RECIPIENT_GAP_HOURS=48
CONTENT_MARKETING_RECONCILE_LIMIT=250
CONTENT_MARKETING_DIGEST_SIZE=12
MARKETING_EMAIL_POLICY_RETRY_MINUTES=60
MARKETING_EMAIL_POLICY_FAILURE_CIRCUIT_BREAKER=3
# Course lessons are intentionally OFF: broadcast top-level courses, not every lesson.
CONTENT_MARKETING_INCLUDE_COURSE_CONTENT=false

# Snippe payments
SNIPPE_API_KEY=replace-me
SNIPPE_WEBHOOK_SECRET=replace-me

# Private uploads
PRIVATE_MEDIA_ROOT=/absolute/private/path/chuosmart/private_media

# Sessions
SESSION_COOKIE_AGE=1209600
SESSION_IDLE_TIMEOUT=604800

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CEREBRAS_API_KEY=
CERTIFICATE_SIGNING_SECRET=replace-with-a-separate-random-secret
TINYMCE_LICENSE_KEY=gpl
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:support@chuosmart.com
JOBS_MAINTENANCE_TOKEN=

# Required scheduled task (for example every minute or every 5 minutes):
# python manage.py run_email_marketing_engine --send-limit 10
